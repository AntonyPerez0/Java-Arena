+/// An embedder's console writer reports `QuotaExceeded` when its output limit is reached; that
+/// stops the program instead of becoming an `IOException` that `PrintStream` would swallow.
+fn console_write_error(error: std::io::Error) -> ristretto_types::Error {
+    use std::io::ErrorKind as Kind;
+    if error.kind() == Kind::QuotaExceeded {
+        ristretto_types::Error::Halt(1)
+    } else {
+        IoException(error.to_string()).into()
+    }
+}
