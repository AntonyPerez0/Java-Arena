+//! Java Arena runner: execute precompiled class files with stdin and arguments supplied up front.
+//!
+//! Java stdout and stderr go to the component's WASI stdout and stderr as raw bytes, capped at
+//! `outputLimit` bytes in total. The returned JSON reports the exit code and whether output was
+//! truncated. Program files live in the host's in-memory file system under the working directory.
+
+use ristretto_vm::{ClassPath, ClassPathEntry, ConfigurationBuilder, Memory, STDIN_AVAILABLE, VM, Value};
+use serde::Deserialize;
+use serde_json::json;
+use std::io::{self, Read, Write};
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use tokio::sync::Mutex;
+
+const DEFAULT_OUTPUT_LIMIT: usize = 64 * 1024;
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct ArenaRequest {
+    main_class: String,
+    #[serde(default)]
+    args: Vec<String>,
+    classes: Vec<Vec<u8>>,
+    #[serde(default)]
+    stdin: Vec<u8>,
+    #[serde(default)]
+    output_limit: Option<usize>,
+}
+
+#[derive(Debug, Default)]
+struct OutputBudget {
+    limit: usize,
+    written: AtomicUsize,
+    truncated: AtomicBool,
+}
+
+/// Standard input supplied up front; EOF after the last byte. Publishes the remaining byte count
+/// so `System.in.available()` answers like `HotSpot` does for redirected input.
+struct Stdin {
+    bytes: Vec<u8>,
+    position: usize,
+}
+
+impl Stdin {
+    fn new(bytes: Vec<u8>) -> Self {
+        STDIN_AVAILABLE.store(i64::try_from(bytes.len()).unwrap_or(i64::MAX), Ordering::Relaxed);
+        Self { bytes, position: 0 }
+    }
+}
+
+impl Read for Stdin {
+    fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+        let rest = self.bytes.get(self.position..).unwrap_or_default();
+        let count = rest.len().min(buffer.len());
+        buffer[..count].copy_from_slice(&rest[..count]);
+        self.position += count;
+        let left = self.bytes.len() - self.position;
+        STDIN_AVAILABLE.store(i64::try_from(left).unwrap_or(i64::MAX), Ordering::Relaxed);
+        Ok(count)
+    }
+}
+
+/// Writes Java output to the component's stdout or stderr. Output is buffered because every
+/// host call is expensive in the browser; the buffer is flushed when it fills and after the run.
+struct CappedWriter {
+    budget: Arc<OutputBudget>,
+    stderr: bool,
+    buffer: Vec<u8>,
+}
+
+const FLUSH_THRESHOLD: usize = 16 * 1024;
+
+impl CappedWriter {
+    fn new(budget: Arc<OutputBudget>, stderr: bool) -> Self {
+        Self { budget, stderr, buffer: Vec::new() }
+    }
+
+    fn drain(&mut self) -> io::Result<()> {
+        if self.buffer.is_empty() {
+            return Ok(());
+        }
+        if self.stderr {
+            let mut sink = io::stderr().lock();
+            sink.write_all(&self.buffer)?;
+            sink.flush()?;
+        } else {
+            let mut sink = io::stdout().lock();
+            sink.write_all(&self.buffer)?;
+            sink.flush()?;
+        }
+        self.buffer.clear();
+        Ok(())
+    }
+
+    fn accept(&mut self, bytes: &[u8]) -> io::Result<()> {
+        self.buffer.extend_from_slice(bytes);
+        if self.buffer.len() >= FLUSH_THRESHOLD {
+            self.drain()?;
+        }
+        Ok(())
+    }
+}
+
+impl Write for CappedWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        let written = self.budget.written.load(Ordering::Relaxed);
+        let room = self.budget.limit.saturating_sub(written);
+        if bytes.len() <= room {
+            self.accept(bytes)?;
+            self.budget.written.store(written + bytes.len(), Ordering::Relaxed);
+            return Ok(bytes.len());
+        }
+        // Keep everything up to the cap, then stop the program (the VM maps QuotaExceeded to a halt).
+        self.accept(&bytes[..room])?;
+        self.drain()?;
+        self.budget.written.store(self.budget.limit, Ordering::Relaxed);
+        self.budget.truncated.store(true, Ordering::Relaxed);
+        Err(io::Error::new(io::ErrorKind::QuotaExceeded, "output limit exceeded"))
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+fn java_home() -> PathBuf {
+    std::env::var_os("RISTRETTO_PLAYGROUND_JAVA_HOME").map_or_else(|| PathBuf::from("/jdk"), PathBuf::from)
+}
+
+fn workspace() -> PathBuf {
+    std::env::var_os("RISTRETTO_PLAYGROUND_WORKSPACE")
+        .map_or_else(|| PathBuf::from("/workspace"), PathBuf::from)
+}
+
+type Streams = (Arc<Mutex<CappedWriter>>, Arc<Mutex<CappedWriter>>);
+
+fn configuration(request: &ArenaRequest, streams: &Streams, memory: Memory) -> ConfigurationBuilder {
+    let builder = ConfigurationBuilder::new()
+        .java_home(java_home())
+        .interpreted(true)
+        .main_class(&request.main_class)
+        .class_path(ClassPath::new(vec![ClassPathEntry::Memory(memory)]))
+        .stdin(Arc::new(Mutex::new(Stdin::new(request.stdin.clone()))))
+        .stdout(streams.0.clone())
+        .stderr(streams.1.clone())
+        .add_system_property("user.dir", workspace().to_string_lossy())
+        .add_system_property("java.io.tmpdir", "/tmp")
+        .add_system_property("user.home", workspace().to_string_lossy())
+        .add_system_property("user.language", "en")
+        .add_system_property("user.country", "US")
+        .add_system_property("user.timezone", "UTC")
+        .add_system_property("file.encoding", "UTF-8")
+        .add_system_property("stdout.encoding", "UTF-8")
+        .add_system_property("stderr.encoding", "UTF-8")
+        .add_system_property("sun.jnu.encoding", "UTF-8")
+        .add_system_property("java.util.concurrent.ForkJoinPool.common.parallelism", "0");
+    #[cfg(target_family = "wasm")]
+    let builder = builder.add_system_property("os.name", "Linux");
+    builder
+}
+
+/// Ask the JDK to report an uncaught exception the way `HotSpot` does: the thread's handler,
+/// which prints `Exception in thread "main" ` followed by the stack trace.
+async fn dispatch_uncaught(vm: &VM, throwable: &Value) -> ristretto_vm::Result<()> {
+    let thread = vm
+        .invoke("java.lang.Thread", "currentThread()Ljava/lang/Thread;", &[] as &[Value])
+        .await?
+        .ok_or_else(|| ristretto_vm::Error::InternalError("no current thread".to_string()))?;
+    vm.invoke(
+        "java.lang.Thread",
+        "dispatchUncaughtException(Ljava/lang/Throwable;)V",
+        &[thread, throwable.clone()],
+    )
+    .await?;
+    Ok(())
+}
+
+async fn shutdown(vm: &VM) -> Option<i32> {
+    match vm.invoke("java.lang.Shutdown", "shutdown()V", &[] as &[Value]).await {
+        Err(ristretto_vm::Error::Halt(code)) => Some(code),
+        _ => None,
+    }
+}
+
+async fn run(request: &ArenaRequest, streams: &Streams) -> Result<i32, String> {
+    let memory = Memory::new("arena");
+    for class in &request.classes {
+        memory.add_class(class).await.map_err(|error| error.to_string())?;
+    }
+    // Relative paths in java.nio.file resolve against the process directory, as with HotSpot,
+    // where it equals user.dir.
+    std::env::set_current_dir(workspace()).map_err(|error| error.to_string())?;
+    let config = configuration(request, streams, memory).build().map_err(|error| error.to_string())?;
+    let vm = VM::new(config).await.map_err(|error| error.to_string())?;
+    let exit_code = match vm.invoke_main(&request.args).await {
+        Ok(_) => shutdown(&vm).await.unwrap_or(0),
+        Err(ristretto_vm::Error::Halt(code)) => code,
+        Err(ristretto_vm::Error::Throwable(throwable)) => match dispatch_uncaught(&vm, &throwable).await {
+            Err(ristretto_vm::Error::Halt(code)) => code,
+            Err(error) => return Err(error.to_string()),
+            Ok(()) => shutdown(&vm).await.unwrap_or(1),
+        },
+        Err(error) => return Err(error.to_string()),
+    };
+    Ok(exit_code)
+}
+
+/// Decode one run request, execute it on a fresh VM, and return the JSON result.
+pub async fn handle(request: &[u8]) -> String {
+    let request = match serde_json::from_slice::<ArenaRequest>(request) {
+        Ok(request) => request,
+        Err(error) => return json!({"error": format!("bad request: {error}")}).to_string(),
+    };
+    let budget = Arc::new(OutputBudget {
+        limit: request.output_limit.unwrap_or(DEFAULT_OUTPUT_LIMIT),
+        ..OutputBudget::default()
+    });
+    let streams: Streams = (
+        Arc::new(Mutex::new(CappedWriter::new(budget.clone(), false))),
+        Arc::new(Mutex::new(CappedWriter::new(budget.clone(), true))),
+    );
+    let result = ristretto_vm::with_local_set(run(&request, &streams)).await;
+    for stream in [&streams.0, &streams.1] {
+        let _ = stream.lock().await.drain();
+    }
+    let truncated = budget.truncated.load(Ordering::Relaxed);
+    STDIN_AVAILABLE.store(-1, Ordering::Relaxed);
+    match result {
+        Ok(exit_code) => json!({"exitCode": exit_code, "outputTruncated": truncated}),
+        // The output cap stops the program through a halt; any other failure is a VM error.
+        Err(message) => json!({"exitCode": 1, "outputTruncated": truncated, "error": message}),
+    }
+    .to_string()
+}
