diff --git a/ristretto_intrinsics/src/sun/nio/fs/wasilinuxnativedispatcher.rs b/ristretto_intrinsics/src/sun/nio/fs/wasilinuxnativedispatcher.rs
new file mode 100644
index 0000000..673a206
--- /dev/null
+++ b/ristretto_intrinsics/src/sun/nio/fs/wasilinuxnativedispatcher.rs
@@ -0,0 +1,62 @@
+//! `LinuxNativeDispatcher` for WASI. The browser runner reports `os.name` as Linux, so the JDK
+//! uses `LinuxFileSystem`, whose `Files.copy` calls these natives. There is no kernel copy, so
+//! `directCopy0` answers `IOStatus.UNSUPPORTED` and the JDK falls back to `bufferedCopy0`.
+use ristretto_classfile::JAVA_21;
+use ristretto_classfile::VersionSpecification::{Any, GreaterThanOrEqual};
+use ristretto_classloader::Value;
+use ristretto_macros::intrinsic_method;
+use ristretto_types::Thread;
+use ristretto_types::{Parameters, Result};
+use std::sync::Arc;
+
+/// `IOStatus.UNSUPPORTED`
+const IO_STATUS_UNSUPPORTED: i32 = -4;
+
+#[intrinsic_method("sun/nio/fs/LinuxNativeDispatcher.init()V", Any)]
+pub fn init<T: Thread + 'static>(_thread: Arc<T>, _parameters: Parameters) -> Result<Option<Value>> {
+    Ok(None)
+}
+
+#[intrinsic_method(
+    "sun/nio/fs/LinuxNativeDispatcher.posix_fadvise(IJJI)I",
+    GreaterThanOrEqual(JAVA_21)
+)]
+pub fn posix_fadvise<T: Thread + 'static>(
+    _thread: Arc<T>,
+    _parameters: Parameters,
+) -> Result<Option<Value>> {
+    Ok(Some(Value::Int(0)))
+}
+
+#[intrinsic_method(
+    "sun/nio/fs/LinuxNativeDispatcher.directCopy0(IIJ)I",
+    GreaterThanOrEqual(JAVA_21)
+)]
+pub fn direct_copy_0<T: Thread + 'static>(
+    _thread: Arc<T>,
+    _parameters: Parameters,
+) -> Result<Option<Value>> {
+    Ok(Some(Value::Int(IO_STATUS_UNSUPPORTED)))
+}
+
+/// `statvfs` for the in-memory file system: 4 KiB blocks, 1 GiB total, all of it free.
+/// `Files.copy` asks for the block size to size its buffer.
+#[intrinsic_method(
+    "sun/nio/fs/UnixNativeDispatcher.statvfs0(JLsun/nio/fs/UnixFileStoreAttributes;)V",
+    Any
+)]
+pub fn statvfs_0<T: Thread + 'static>(
+    _thread: Arc<T>,
+    mut parameters: Parameters,
+) -> Result<Option<Value>> {
+    const BLOCK_SIZE: i64 = 4096;
+    const BLOCKS: i64 = (1 << 30) / BLOCK_SIZE;
+    let attributes = parameters.pop()?;
+    let _path_address = parameters.pop_long()?;
+    let mut attributes = attributes.as_object_mut()?;
+    attributes.set_value("f_frsize", Value::Long(BLOCK_SIZE))?;
+    attributes.set_value("f_blocks", Value::Long(BLOCKS))?;
+    attributes.set_value("f_bfree", Value::Long(BLOCKS))?;
+    attributes.set_value("f_bavail", Value::Long(BLOCKS))?;
+    Ok(None)
+}
