+async fn module_and_loader(thread: &Thread, class_name: &str) -> Result<(String, String)> {
+    let element = class_name.trim_start_matches('[');
+    let element = if element.len() == class_name.len() {
+        element
+    } else if let Some(name) = element.strip_prefix('L').and_then(|name| name.strip_suffix(';')) {
+        name
+    } else {
+        return Ok(("module java.base".to_string(), "'bootstrap'".to_string()));
+    };
