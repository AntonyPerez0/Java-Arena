+    let module = match class.module_name()? {
+        Some(module) => format!("module {module}"),
+        None => "unnamed module".to_string(),
+    };
+    let loader = match class.class_loader()? {
+        Some(loader) if loader.name() != "bootstrap" => format!("'{}'", loader.name()),
+        _ => "'bootstrap'".to_string(),
+    };
+    Ok((module, loader))
