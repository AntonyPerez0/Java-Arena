+    let same_module = source_module == target_module
+        && (source_module != "unnamed module" || source_loader == target_loader);
+    if same_module {
+        Ok(format!(
+            " ({source} and {target} are in {source_module} of loader {source_loader})"
+        ))
+    } else {
+        Ok(format!(
+            " ({source} is in {source_module} of loader {source_loader}; {target} is in {target_module} of loader {target_loader})"
