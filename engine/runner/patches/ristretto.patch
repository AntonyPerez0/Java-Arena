+fn parse_type(descriptor: &str) -> Option<(String, usize)> {
+    let first = descriptor.chars().next()?;
+    let name = match first {
+        'Z' => "boolean",
+        'B' => "byte",
+        'C' => "char",
+        'S' => "short",
+        'I' => "int",
+        'J' => "long",
+        'F' => "float",
+        'D' => "double",
+        'V' => "void",
+        'L' => {
+            let end = descriptor.find(';')?;
+            return Some((external_class_name(descriptor.get(1..end)?), end + 1));
+        }
+        '[' => {
+            let (component, length) = parse_type(descriptor.get(1..)?)?;
+            return Some((format!("{component}[]"), length + 1));
+        }
+        _ => return None,
+    };
+    Some((name.to_string(), 1))
