{
  "name": "java-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Learn Java in the browser with real compiling and running, following the order and topics of the University of Helsinki Java Programming MOOC.",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "content": "node scripts/build-content.mjs",
    "predev": "node scripts/build-content.mjs",
    "dev": "vite",
    "build": "node scripts/copy-engine.mjs && node scripts/build-content.mjs && tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/finish-build.mjs",
    "preview": "vite preview",
    "content:browser": "node scripts/content-browser.mjs",
    "fidelity:jdk": "node scripts/fidelity/jdk.mjs",
    "fidelity:browser": "node scripts/fidelity/browser.mjs",
    "fidelity": "node scripts/fidelity/jdk.mjs && node scripts/fidelity/browser.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:unit": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.48.0",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  }
}
