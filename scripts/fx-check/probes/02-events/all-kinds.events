// Every kind of event and target that works. Nodes: 1 VBox, 2 Label, 3 name, 4 plain, 5 secret,
// 6 notes, 7 HBox, 8 Greet, 9 Count, 10 Inert, 11 Off, 12 Hidden, 13 HBox, 14 button, 15 field ...
type TextField 1 "Ada"
enter TextField 1
enter #4
click Button "Greet"
click #greet
click #9
click Button 2
click ButtonBase 2
click Labeled "Count"
click Button "Inert"
click Button "Off"
click Button "In a disabled box"
enter TextField "locked"
set TextField 1 "Grace"
set TextField "no handler" "changed"
type PasswordField 1 "s3crét"
type TextArea 1 "line one\nline two\ttab"
set TextArea 1 "replaced"
type TextField 2 "\ttab\nnewline\r!"
type TextField 1 " 😀"
type TextInputControl 3 "+"
set TextInputControl 4 "four"
type #3 "?"
enter TextField 1
set TextField 1 ""
type TextField 1 "\"quoted\" \\ back"
click Node 9
